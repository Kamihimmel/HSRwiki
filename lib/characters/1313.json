            "ENname": "Gleaming Admonition",
            "CNname": "闪烁的劝诫",
            "JAname": "{RUBY_B#ひかり}光{RUBY_E#}を{RUBY_B#まと}纏{RUBY_E#}う{RUBY_B#こくゆ}告諭{RUBY_E#}",
